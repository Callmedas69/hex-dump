# Development substitute: hold at least 0.01 USDG on Robinhood Chain mainnet (4663).
NEXT_PUBLIC_USDG_PROFILE=robinhood-mainnet
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional RPC overrides; public keys are visible in the browser.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
NEXT_PUBLIC_ENABLE_DEV_BYPASS=false
# Production deployment must explicitly configure the meme token; missing values fail closed.
NEXT_PUBLIC_MEME_TOKEN_ADDRESS=
NEXT_PUBLIC_MEME_TOKEN_CHAIN_ID=4663
NEXT_PUBLIC_MEME_TOKEN_SYMBOL=
NEXT_PUBLIC_MEME_TOKEN_DECIMALS=18
NEXT_PUBLIC_MEME_TOKEN_MIN_RAW=1
# X OAuth is intentionally server-only when implemented. Composer fallback works without credentials.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/api/x/callback
# Set memory only on a single persistent Node process to enable direct X posting.
X_SESSION_STORE=
